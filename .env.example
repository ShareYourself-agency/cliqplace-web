# Odesílání kontaktního formuláře přes Resend (https://resend.com)
RESEND_API_KEY=
# Kam chodí poptávky
CONTACT_TO=info@cliqplace.cz
# Odesílatel – doména musí být ověřená v Resendu
CONTACT_FROM=Web Cliqplace <web@cliqplace.cz>

# Databáze leadů (Vercel → Storage → Neon Postgres → Connect to project vyplní samo)
DATABASE_URL=
# Administrace /admin – první účet (při prvním přihlášení se založí, další lidi se přidávají v /admin/tym)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Zálohy CRM (Vercel → Storage → Blob, Private → připojit k projektu – vyplní se samo)
BLOB_READ_WRITE_TOKEN=
