---
import Admin from '../../layouts/Admin.astro';
import { db, hasDb, STAGES, OPEN_STAGES, kindLabel, type Task } from '../../lib/db';
import { importParked } from '../../lib/backup';
import { ago, czk, due, initials } from '../../lib/format';
export const prerender = false;

const me = Astro.locals.user!;
let err = '';
let k = { fresh: 0, uncontacted24: 0, open: 0, openValue: 0, weighted: 0, wonMonth: 0, wonMonthValue: 0, winRate: null as number | null, myOverdue: 0 };
let myTasks: Task[] = [];
let fresh: { id: number; company: string; name: string; created_at: Date; owner_name: string | null }[] = [];
let noStep: { id: number; company: string; name: string; status: string; last_activity_at: Date | null }[] = [];
let funnel: { status: string; n: number; v: number }[] = [];
let feed: { lead_id: number; at: Date; kind: string; text: string; company: string; name: string; user_name: string | null }[] = [];

if (!hasDb()) err = 'Databáze není připojená (chybí DATABASE_URL).';
else {
  try {
    await importParked().catch(() => 0);
    const s = await db();
    const [a] = await s<any[]>`
      select
        count(*) filter (where status = 'new')::int as fresh,
        count(*) filter (where status = 'new' and first_contact_at is null and created_at < now() - interval '24 hours')::int as uncontacted24,
        count(*) filter (where status = any(${OPEN_STAGES}))::int as open,
        coalesce(sum(value) filter (where status = any(${OPEN_STAGES})), 0)::bigint as open_value,
        coalesce(sum(value * coalesce(probability, case status when 'new' then 10 when 'contacted' then 20 when 'demo' then 40 when 'offer' then 60 when 'negotiation' then 80 else 0 end) / 100.0) filter (where status = any(${OPEN_STAGES})), 0)::bigint as weighted,
        count(*) filter (where status = 'won' and updated_at >= date_trunc('month', now()))::int as won_month,
        coalesce(sum(value) filter (where status = 'won' and updated_at >= date_trunc('month', now())), 0)::bigint as won_month_value,
        count(*) filter (where status = 'won' and updated_at > now() - interval '90 days')::int as won90,
        count(*) filter (where status = 'lost' and updated_at > now() - interval '90 days')::int as lost90
      from leads where deleted_at is null`;
    const closed = a.won90 + a.lost90;
    myTasks = await s<Task[]>`
      select t.*, l.company, l.name as lead_name from tasks t join leads l on l.id = t.lead_id
      where t.done_at is null and t.user_id = ${me.id} and l.deleted_at is null
      order by t.due_at asc nulls last limit 12`;
    const [{ n: myOverdue }] = await s<{ n: number }[]>`
      select count(*)::int as n from tasks t join leads l on l.id = t.lead_id
      where t.done_at is null and t.user_id = ${me.id} and l.deleted_at is null
        and t.due_at < (date_trunc('day', now() at time zone 'Europe/Prague') at time zone 'Europe/Prague')`;
    k = { fresh: a.fresh, uncontacted24: a.uncontacted24, open: a.open, openValue: Number(a.open_value), weighted: Number(a.weighted), wonMonth: a.won_month, wonMonthValue: Number(a.won_month_value), winRate: closed ? Math.round((a.won90 / closed) * 100) : null, myOverdue };
    fresh = await s<any[]>`select l.id, l.company, l.name, l.created_at, u.name as owner_name from leads l left join admin_users u on u.id = l.owner_id where l.status = 'new' and l.deleted_at is null order by l.created_at asc limit 8`;
    noStep = await s<any[]>`
      select id, company, name, status, last_activity_at from leads
      where deleted_at is null and status = any(${OPEN_STAGES}) and status <> 'new'
        and not exists (select 1 from tasks t where t.lead_id = leads.id and t.done_at is null)
      order by coalesce(last_activity_at, created_at) asc limit 6`;
    funnel = await s<any[]>`select status, count(*)::int as n, coalesce(sum(value),0)::bigint as v from leads where deleted_at is null group by status`;
    feed = await s<any[]>`
      select e.lead_id, e.at, e.kind, e.text, l.company, l.name, u.name as user_name, u.email as user_email
      from lead_events e join leads l on l.id = e.lead_id left join admin_users u on u.id = e.user_id
      where l.deleted_at is null order by e.at desc limit 10`;
  } catch (e) {
    console.error('[admin] dashboard', e);
    err = 'Nepodařilo se načíst data. Zkuste stránku obnovit.';
  }
}
const fmap = Object.fromEntries(funnel.map((f) => [f.status, f]));
const maxN = Math.max(1, ...funnel.map((f) => f.n));
const hello = (me.name || '').split(' ')[0];
---
<Admin title="Přehled" section="prehled">
  <div class="page-head">
    <div>
      <p class="eyebrow">{new Intl.DateTimeFormat('cs-CZ', { timeZone: 'Europe/Prague', weekday: 'long', day: 'numeric', month: 'long' }).format(new Date())}</p>
      <h1 class="h1">{hello ? `Ahoj ${hello}` : 'Přehled'}</h1>
    </div>
  </div>

  {err ? <div class="panel empty mono">{err}</div> : (
    <>
      <section class="kpis">
        <a class:list={['kpi panel', { 'kpi--hot': k.fresh > 0 }]} href="/admin/leady?stage=new">
          <span class="eyebrow">Nové k oslovení</span>
          <strong class="kpi__n">{k.fresh}</strong>
          <span class:list={['mono', k.uncontacted24 ? 'pill pill--red' : 'faint']}>{k.uncontacted24 ? `${k.uncontacted24} čeká přes 24 h` : 'vše do 24 h'}</span>
        </a>
        <a class:list={['kpi panel', { 'kpi--warn': k.myOverdue > 0 }]} href="/admin/ukoly">
          <span class="eyebrow">Moje úkoly po termínu</span>
          <strong class="kpi__n">{k.myOverdue}</strong>
          <span class="mono faint">{myTasks.length} otevřených</span>
        </a>
        <a class="kpi panel" href="/admin/pipeline">
          <span class="eyebrow">Otevřené obchody</span>
          <strong class="kpi__n">{k.open}</strong>
          <span class="mono faint">{czk(k.openValue)}</span>
        </a>
        <div class="kpi panel">
          <span class="eyebrow">Vážená pipeline</span>
          <strong class="kpi__n kpi__n--sm">{czk(k.weighted)}</strong>
          <span class="mono faint">hodnota × pravděpodobnost</span>
        </div>
        <div class="kpi panel">
          <span class="eyebrow">Vyhráno tento měsíc</span>
          <strong class="kpi__n">{k.wonMonth}</strong>
          <span class="mono faint">{czk(k.wonMonthValue)} · úspěšnost {k.winRate === null ? '—' : `${k.winRate} %`}</span>
        </div>
      </section>

      <div class="grid-2">
        <div class="stack">
          <section class="panel block">
            <div class="block__head"><h2 class="h2">Moje úkoly</h2><a class="mono link" href="/admin/ukoly">všechny úkoly</a></div>
            {myTasks.length === 0 ? <p class="faint">Nemáte žádné otevřené úkoly.</p> : (
              <div class="tasks">
                {myTasks.map((t) => { const d = due(t.due_at); return (
                  <div class="task">
                    <form method="post" action={`/admin/lead/${t.lead_id}`}>
                      <input type="hidden" name="action" value="task_toggle" /><input type="hidden" name="task_id" value={t.id} /><input type="hidden" name="redirect" value="/admin" />
                      <button class="task__check" type="submit" aria-label="Označit jako hotové"></button>
                    </form>
                    <a href={`/admin/lead/${t.lead_id}`} class="ell"><span class="task__title">{t.title}</span> <span class="faint">· {t.company || t.lead_name}</span></a>
                    <span class={`pill ${d.tone ? `pill--${d.tone}` : ''}`}>{d.label}</span>
                  </div>
                ); })}
              </div>
            )}
          </section>

          <section class="panel block">
            <div class="block__head"><h2 class="h2">Nové poptávky k oslovení</h2><a class="mono link" href="/admin/leady?stage=new">otevřít</a></div>
            {fresh.length === 0 ? <p class="faint">Všechny poptávky jsou oslovené.</p> : fresh.map((l) => (
              <a class="list-row" href={`/admin/lead/${l.id}`}>
                <span class="ell"><strong>{l.company || l.name}</strong> <span class="faint">{l.company ? `· ${l.name}` : ''}{l.owner_name ? ` · řeší ${l.owner_name}` : ' · nepřiřazeno'}</span></span>
                <span class:list={['pill', { 'pill--red': Date.now() - new Date(l.created_at).getTime() > 864e5 }]}>{ago(l.created_at)}</span>
              </a>
            ))}
          </section>

          {noStep.length > 0 && (
            <section class="panel block">
              <div class="block__head"><h2 class="h2">Obchody bez dalšího kroku</h2><span class="mono faint">naplánujte úkol, ať nevychladnou</span></div>
              {noStep.map((l) => (
                <a class="list-row" href={`/admin/lead/${l.id}`}>
                  <span class="ell"><strong>{l.company || l.name}</strong> <span class={`tag tag--${l.status}`}>{STAGES.find((s) => s.id === l.status)?.label}</span></span>
                  <span class="pill pill--amber">{l.last_activity_at ? `aktivita ${ago(l.last_activity_at)}` : 'bez aktivity'}</span>
                </a>
              ))}
            </section>
          )}
        </div>

        <div class="stack">
          <section class="panel block">
            <div class="block__head"><h2 class="h2">Pipeline</h2><a class="mono link" href="/admin/pipeline">board</a></div>
            <div class="funnel">
              {STAGES.map((st) => { const f = fmap[st.id] || { n: 0, v: 0 }; return (
                <a class="funnel__row" href={`/admin/leady?stage=${st.id}`}>
                  <span><span class={`tag tag--${st.id}`}>{st.label}</span></span>
                  <span class="bar"><i style={`width:${Math.round((f.n / maxN) * 100)}%`}></i></span>
                  <span class="mono num" style="text-align:right">{f.n} · {czk(Number(f.v))}</span>
                </a>
              ); })}
            </div>
          </section>

          <section class="panel block">
            <h2 class="h2">Poslední aktivita</h2>
            {feed.length === 0 ? <p class="faint">Zatím nic.</p> : (
              <ol class="timeline">
                {feed.map((e: any) => (
                  <li class={`ev ev--${e.kind}`}>
                    <span class="ev__dot">{e.user_name || e.user_email ? initials(e.user_name || e.user_email) : 'W'}</span>
                    <div style="min-width:0">
                      <div class="ev__head"><a class="link" href={`/admin/lead/${e.lead_id}`}>{e.company || e.name}</a><span class="mono faint">{kindLabel(e.kind)} · {ago(e.at)}</span></div>
                      <p class="ev__text ell">{e.text}</p>
                    </div>
                  </li>
                ))}
              </ol>
            )}
          </section>
        </div>
      </div>
    </>
  )}
</Admin>
