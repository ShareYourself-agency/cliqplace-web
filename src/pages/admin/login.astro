---
import Admin from '../../layouts/Admin.astro';
import { adminReady, currentUser, login, loginBlocked, noteFail, startSession } from '../../lib/auth';
export const prerender = false;

let error = '';
let email = '';
if (!adminReady()) error = 'Administrace ještě není připojená k databázi.';
else {
  try {
    if (await currentUser(Astro.cookies)) return Astro.redirect('/admin', 303);
  } catch {}
  if (Astro.request.method === 'POST') {
    const ip = (Astro.request.headers.get('x-forwarded-for') || '').split(',')[0].trim() || Astro.clientAddress || '?';
    const fd = await Astro.request.formData();
    email = String(fd.get('email') || '').trim().slice(0, 200);
    if (loginBlocked(ip) || loginBlocked(email.toLowerCase())) error = 'Příliš mnoho pokusů. Zkuste to za 15 minut.';
    else {
      const user = await login(email, String(fd.get('password') || ''));
      if (user) {
        await startSession(Astro.cookies, user.id, Astro.url.protocol === 'https:');
        return Astro.redirect('/admin', 303);
      }
      noteFail(ip);
      noteFail(email.toLowerCase());
      await new Promise((r) => setTimeout(r, 400));
      error = 'Nesprávný e-mail nebo heslo.';
    }
  }
}
---
<Admin title="Přihlášení" bare>
  <main class="login">
    <form class="login__card panel" method="post" data-native>
      <p class="eyebrow">cliqplace / crm</p>
      <h1 class="h1">Přihlášení</h1>
      <label class="field"><span>E-mail</span><input class="input" type="email" name="email" value={email} autocomplete="username" required autofocus /></label>
      <label class="field"><span>Heslo</span><input class="input" type="password" name="password" autocomplete="current-password" required /></label>
      {error && <p class="login__err mono">{error}</p>}
      <button class="btn" type="submit">Přihlásit se</button>
    </form>
  </main>
</Admin>
