---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import BgVideo from '../components/BgVideo.astro';
import StepsLoop from '../components/StepsLoop.astro';
import ProductTrio from '../components/ProductTrio.astro';
import Reviews from '../components/Reviews.astro';
import FinalCta from '../components/FinalCta.astro';
import Faq from '../components/Faq.astro';
import { faqMain } from '../data/faq';
import phoneFrame from '../assets/img/phone-frame.png';
// decorative QR pattern
const QN = 25; let qs = 11; const qr = () => ((qs = (qs * 9301 + 49297) % 233280) / 233280);
const inF = (x: number, y: number) => [[0, 0], [QN - 7, 0], [0, QN - 7]].some(([a, b]) => x >= a && x < a + 7 && y >= b && y < b + 7);
const qCells: string[] = []; for (let y = 0; y < QN; y++) for (let x = 0; x < QN; x++) if (!inF(x, y) && qr() > 0.5) qCells.push(`M${x} ${y}h1v1h-1z`);
const qFind = [[0, 0], [QN - 7, 0], [0, QN - 7]].map(([x, y]) => `M${x} ${y}h7v7h-7zM${x + 1} ${y + 1}v5h5v-5zM${x + 2} ${y + 2}h3v3h-3z`).join('');

const steps = [
  { title: 'Zjistíme, co potřebujete', text: 'Probereme velikost provozu a typ akcí, následně navrhneme vybavení.' },
  { title: 'Vybereme zařízení', text: 'Skenery, tiskárny, terminály nebo kiosky přesně podle toho, co zrovna potřebujete.' },
  { title: 'Dodáme a nastavíme', text: 'Zařízení nainstalujeme a propojíme s celým systémem.' },
  { title: 'Můžete začít', text: 'Akce může začít. Jde to i bez komplikací.' },
];
---
<Base
  title="Hardware pro prodej a odbavení vstupenek"
  description="Skenery, platební terminály, tiskárny vstupenek, kiosky a výdejní boxy. Dodáme a propojíme techniku, která funguje jako součást celého Cliqplace systému."
>
  <PageHero visualClass="hw-hero-visual">
    <Fragment slot="title"><em>Hardware,</em> který drží krok s vaším provozem.</Fragment>
    <Fragment slot="lead">Od prodeje na pokladně až po kontrolu vstupenek u vstupu. Dodáme a propojíme techniku, která je připravená fungovat jako součást celého Cliqplace systému.</Fragment>
    <img slot="visual" src="/svg/cliqplace-hardware-zarizeni-pruhledne.svg" alt="Čtečka vstupenek, platební terminál, samoobslužný kiosek a tiskárna vstupenek" width="1346" height="465" fetchpriority="high" />
  </PageHero>

  <div class="sheet">
    <section class="section" aria-labelledby="hw-features-title">
      <div class="container">
        <div class="section-head">
          <h2 class="h2" id="hw-features-title">Všechno, co potřebujete.<br /> Připravené fungovat.</h2>
          <p class="lead">Skenery, terminály, tiskárny i kiosky propojené s celým systémem.</p>
        </div>

        <div class="bento">
          <div class="bento__col">
            <article class="bcard bcard--light" data-reveal>
              <h3 class="bcard__title">Odbavte návštěvníky bez zdržování</h3>
              <p class="bcard__text">Skenery pro rychlou kontrolu QR kódů a plynulý vstup návštěvníků.</p>
              <div class="bcard__visual hw-scan" role="img" aria-label="Mobilní vstupenka s QR kódem a potvrzením platnosti: řada 3, sedadlo 12">
                <div class="scan-phone">
                  <div class="scan-phone__screen">
                    <svg viewBox={`-1 -1 ${QN + 2} ${QN + 2}`} aria-hidden="true"><path d={qFind} fill="#0d1513" fill-rule="evenodd" /><path d={qCells.join('')} fill="#0d1513" /></svg>
                    <p>Transformers 2</p>
                    <span class="scan-phone__beam" aria-hidden="true"></span>
                  </div>
                  <Image class="scan-phone__frame" src={phoneFrame} alt="" widths={[440, 878]} sizes="220px" loading="lazy" />
                </div>
                <div class="scan-ok" aria-hidden="true"><span class="scan-ok__ico"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span><span>Řada 3<br />Sedadlo 12</span></div>
              </div>
            </article>
            <article class="bcard bcard--light bcard--media-light" data-reveal>
              <BgVideo name="tiskarna" />
              <h3 class="bcard__title">Vytiskněte, co potřebujete</h3>
              <p class="bcard__text">Tiskárny pro vstupenky, účtenky a další doklady přímo propojené s vaším systémem.</p>
            </article>
            <article class="bcard bcard--cta" data-reveal>
              <h3 class="bcard__title">Od pokladny až ke vstupu.</h3>
              <p class="bcard__text">Dodáme, zapojíme a propojíme. Vy jen otevřete brány.</p>
              <a class="btn" href="/kontakt">Domluvit ukázku</a>
            </article>
          </div>
          <div class="bento__col bento__col--offset">
            <article class="bcard bcard--media" data-reveal>
              <BgVideo name="platebni-terminal" />
              <h3 class="bcard__title">Prodávejte přímo na místě</h3>
              <p class="bcard__text">Platební terminály a pokladní řešení pro pohodlný prodej vstupenek i dalších položek.</p>
            </article>
            <article class="bcard bcard--dark hw-more" data-reveal>
              <h3 class="bcard__title">Dejte zákazníkům více možností</h3>
              <p class="bcard__text">Samoobslužné kiosky a výdejní boxy pomáhají zvládnout provoz s menšími frontami a bez zbytečné obsluhy.</p>
              <div class="hw-more__tiles">
                <div class="hw-tile">
                  <svg viewBox="0 0 64 64" aria-hidden="true"><rect x="18" y="6" width="28" height="40" rx="4" /><rect x="22" y="11" width="20" height="22" rx="2" /><path d="M27 38h10M24 46l-4 12h24l-4-12" /></svg>
                  <span>Samoobslužný kiosek</span>
                </div>
                <div class="hw-tile">
                  <svg viewBox="0 0 64 64" aria-hidden="true"><rect x="8" y="8" width="48" height="48" rx="4" /><path d="M8 24h48M8 40h48M32 8v48" /><circle cx="27" cy="16" r="1.5" /><circle cx="27" cy="32" r="1.5" /><circle cx="51" cy="16" r="1.5" /><circle cx="51" cy="48" r="1.5" /></svg>
                  <span>Výdejní box</span>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <StepsLoop steps={steps} />
    <ProductTrio current="hardware" title="Hardware je jen jedna část." />
    <Reviews />
    <FinalCta />
    <Faq items={faqMain} moreLink />
  </div>
</Base>

<style>
  /* hero: devices tucked behind the light sheet, shorter hero */
  :global(.hw-hero-visual) { margin-top: clamp(-4rem, -1rem - 3vw, -1rem) !important; padding-bottom: 0 !important; }
  :global(.hw-hero-visual) img { width: min(100%, 84rem); margin-inline: auto; margin-bottom: calc(var(--radius-xl) * -0.9); }

  /* scanned ticket – built in code, crisp at any size */
  .hw-scan { position: relative; justify-content: center; margin-bottom: calc(clamp(1.5rem, 1.2rem + 0.8vw, 2rem) * -1); height: 15rem; overflow: hidden; align-items: flex-start; }
  .scan-phone { position: relative; width: 13.5rem; aspect-ratio: 878 / 1784; margin-left: 4rem; }
  .scan-phone__frame { position: absolute; inset: 0; width: 100%; height: 100%; }
  .scan-phone__screen { position: absolute; left: 5.2%; right: 4.9%; top: 2.1%; bottom: 2.1%; border-radius: 13% / 6%; background: #fff; display: grid; justify-items: center; align-content: start; padding-top: 30%; overflow: hidden; }
  .scan-phone__screen svg { width: 66%; }
  .scan-phone__screen p { margin-top: 0.6rem; font-weight: 600; font-size: 0.875rem; color: #0d1513; }
  .scan-phone__beam { position: absolute; left: 10%; right: 10%; height: 2px; top: 28%; background: #5dff4a; box-shadow: 0 0 10px 2px rgba(93,255,74,0.7); animation: hw-beam 2.6s ease-in-out infinite; }
  @keyframes hw-beam { 0%, 100% { top: 28%; } 50% { top: 58%; } }
  .scan-ok {
    position: absolute; left: calc(50% - 10rem); top: 6.2rem; display: flex; align-items: center; gap: 0.75rem;
    padding: 0.7rem 1.1rem 0.7rem 0.75rem; border-radius: 0.875rem; background: var(--c-green); color: #fff;
    font-size: 0.875rem; line-height: 1.3; box-shadow: 0 14px 30px -14px rgba(13,21,19,0.6);
  }
  .scan-ok__ico { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--c-lime); }
  .scan-ok__ico svg { width: 1.2rem; fill: none; stroke: #0d1513; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  @media (max-width: 480px) { .scan-phone { width: 11rem; margin-left: 5rem; } .scan-ok { left: 0.25rem; top: 5rem; } }
  @media (prefers-reduced-motion: reduce) { .scan-phone__beam { animation: none; } }
  .hw-more { background: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(76,140,84,0.35), transparent 70%), #0b110f; }
  .hw-more__tiles { margin-top: auto; padding-top: 1.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.875rem; }
  .hw-tile {
    display: grid; justify-items: center; gap: 0.75rem; text-align: center;
    padding: 1.5rem 0.75rem; border-radius: var(--radius);
    background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
    border: 1px solid rgba(199,255,156,0.16); font-size: 0.9375rem; color: rgba(255,255,255,0.9);
  }
  .hw-tile svg { width: 3.5rem; height: 3.5rem; fill: none; stroke: var(--c-lime); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 6px rgba(93,255,74,0.55)); }
  .hw-tile circle { fill: var(--c-lime); stroke: none; }
</style>
