---
interface Props { title: string; bare?: boolean }
const { title, bare = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/admin', label: 'Leady' },
  { href: '/admin?view=pipeline', label: 'Pipeline' },
];
const view = Astro.url.searchParams.get('view');
const active = (href: string) =>
  href.includes('pipeline') ? view === 'pipeline' : (path === '/admin' && view !== 'pipeline') || path.startsWith('/admin/lead');
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Cliqplace Leads</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/InterTight-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    {bare ? <slot /> : (
      <div class="app">
        <header class="top">
          <a class="brand" href="/admin"><span class="brand__mark">cliqplace</span><span class="brand__sub">/leads</span></a>
          <nav class="tabs">
            {nav.map((n) => <a href={n.href} class:list={['tab', { 'is-on': active(n.href) }]}>{n.label}</a>)}
            <a class="tab" href="/admin/export.csv">Export CSV</a>
          </nav>
          <form method="post" action="/admin/logout"><button class="ghost" type="submit">Odhlásit</button></form>
        </header>
        <main class="main"><slot /></main>
      </div>
    )}
  </body>
</html>

<style is:global>
  @font-face { font-family: 'Inter Tight'; src: url('/fonts/InterTight-var.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  :root {
    --bg: #070b0a; --bg-2: #0c1311; --bg-3: #111a17; --line: #1c2925; --line-2: #26372f;
    --tx: #e8efe9; --tx-2: #9aa9a1; --tx-3: #63736b;
    --lime: #c7ff9c; --neon: #5dff4a;
    --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
    --sans: 'Inter Tight', system-ui, sans-serif;
    color-scheme: dark;
  }
  * { box-sizing: border-box; margin: 0; }
  html { background: var(--bg); }
  body {
    font-family: var(--sans); color: var(--tx); font-size: 14px; line-height: 1.5; min-height: 100dvh;
    background:
      radial-gradient(60rem 30rem at 85% -10%, rgba(93, 255, 74, 0.07), transparent 60%),
      var(--bg);
    background-attachment: fixed;
    -webkit-font-smoothing: antialiased;
  }
  body::before {
    content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70rem 40rem at 70% 0%, #000, transparent 75%);
  }
  a { color: inherit; text-decoration: none; }
  button, input, select, textarea { font: inherit; color: inherit; }
  .mono { font-family: var(--mono); font-size: 12px; letter-spacing: 0.02em; }
  .muted { color: var(--tx-2); }
  .faint { color: var(--tx-3); }

  .app { max-width: 1440px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 40px) 64px; }
  .top {
    position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 24px;
    padding: 18px 0; border-bottom: 1px solid var(--line);
    background: linear-gradient(var(--bg) 70%, transparent); backdrop-filter: blur(8px);
  }
  .brand { display: flex; align-items: baseline; gap: 2px; font-weight: 650; letter-spacing: -0.02em; font-size: 17px; }
  .brand__sub { font-family: var(--mono); font-size: 13px; color: var(--neon); font-weight: 500; }
  .tabs { display: flex; gap: 4px; margin-right: auto; overflow-x: auto; }
  .tab {
    font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em;
    padding: 8px 12px; border-radius: 6px; color: var(--tx-2); white-space: nowrap; transition: color .2s, background .2s;
  }
  .tab:hover { color: var(--tx); background: var(--bg-3); }
  .tab.is-on { color: var(--bg); background: var(--lime); }
  .ghost {
    font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em;
    background: none; border: 1px solid var(--line-2); border-radius: 6px; padding: 7px 12px; color: var(--tx-2); cursor: pointer;
  }
  .ghost:hover { color: var(--tx); border-color: var(--tx-3); }
  .main { padding-top: 28px; }
  @media (max-width: 640px) {
    .top { flex-wrap: wrap; gap: 12px 16px; padding: 14px 0 10px; }
    .top form { margin-left: auto; }
    .tabs { order: 3; width: 100%; margin-right: 0; }
  }

  .h1 { font-size: clamp(26px, 2.4vw, 34px); font-weight: 600; letter-spacing: -0.035em; line-height: 1.1; }
  .eyebrow { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--tx-3); }

  .panel { background: color-mix(in srgb, var(--bg-2) 88%, transparent); border: 1px solid var(--line); border-radius: 12px; }

  .tag {
    display: inline-flex; align-items: center; gap: 7px; font-family: var(--mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.08em; padding: 4px 9px 4px 8px; border-radius: 999px; border: 1px solid var(--line-2); color: var(--tx-2); white-space: nowrap;
  }
  .tag::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .tag--new { color: var(--neon); border-color: rgba(93, 255, 74, .35); box-shadow: 0 0 14px rgba(93, 255, 74, .12) inset; }
  .tag--contacted { color: #8fd3ff; border-color: rgba(143, 211, 255, .3); }
  .tag--demo { color: #c9a6ff; border-color: rgba(201, 166, 255, .3); }
  .tag--offer { color: #ffd479; border-color: rgba(255, 212, 121, .3); }
  .tag--won { color: var(--bg); background: var(--lime); border-color: var(--lime); }
  .tag--won::before { background: var(--bg); }
  .tag--lost { color: var(--tx-3); }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; cursor: pointer;
    background: var(--lime); color: #07110a; font-weight: 600; border-radius: 8px; padding: 10px 16px; transition: filter .2s, box-shadow .2s;
  }
  .btn:hover { filter: brightness(1.05); box-shadow: 0 0 24px rgba(93, 255, 74, .25); }
  .input {
    width: 100%; background: var(--bg); border: 1px solid var(--line-2); border-radius: 8px; padding: 10px 12px; outline: none;
    transition: border-color .2s, box-shadow .2s;
  }
  .input:focus { border-color: var(--lime); box-shadow: 0 0 0 3px rgba(199, 255, 156, .12); }
  ::selection { background: var(--lime); color: #07110a; }
</style>
