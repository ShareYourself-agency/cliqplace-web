---
import '../styles/admin.css';
import { db, hasDb } from '../lib/db';
interface Props { title: string; bare?: boolean; section?: string }
const { title, bare = false, section = '' } = Astro.props;
const me = Astro.locals.user;
let counts = { tasks: 0, fresh: 0 };
if (!bare && me && hasDb()) {
  try {
    const s = await db();
    const [c] = await s<{ tasks: number; fresh: number }[]>`
      select
        (select count(*)::int from tasks t join leads l on l.id = t.lead_id where t.done_at is null and l.deleted_at is null and t.user_id = ${me.id} and t.due_at < date_trunc('day', now() at time zone 'Europe/Prague') + interval '1 day') as tasks,
        (select count(*)::int from leads where status = 'new' and deleted_at is null) as fresh`;
    counts = c;
  } catch {}
}
const nav = [
  { id: 'prehled', href: '/admin', label: 'Přehled' },
  { id: 'leady', href: '/admin/leady', label: 'Leady', count: counts.fresh },
  { id: 'pipeline', href: '/admin/pipeline', label: 'Pipeline' },
  { id: 'ukoly', href: '/admin/ukoly', label: 'Úkoly', count: counts.tasks },
];
const initials = (me?.name || me?.email || '?').split(/[\s@.]+/).filter(Boolean).slice(0, 2).map((p) => p[0]).join('');
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Cliqplace CRM</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/InterTight-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body data-section={section}>
    <div class="progress" data-progress></div>
    {bare ? <slot /> : (
      <div class="app">
        <header class="top">
          <a class="brand" href="/admin">cliqplace<span class="brand__sub">/crm</span></a>
          <nav class="nav" aria-label="Hlavní">
            {nav.map((n) => (
              <a href={n.href} class:list={[{ 'is-on': section === n.id }]}>{n.label}{n.count ? <span class="count">{n.count}</span> : null}</a>
            ))}
          </nav>
          <a class="btn btn--lime btn--sm" href="/admin/lead/novy">+ Nový lead</a>
          <details class="menu" data-menu>
            <summary><span class="avatar">{initials}</span><span class="menu__name mono">{me?.name || me?.email}</span></summary>
            <div class="menu__list">
              <span class="mono faint" style="padding:6px 10px">{me?.email}</span>
              <hr />
              <a href="/admin/ucet">Můj účet a heslo</a>
              <a href="/admin/tym">Tým a přístupy</a>
              <a href="/admin/zalohy">Zálohy</a>
              <a href="/admin/export.csv" data-native>Export CSV</a>
              <a href="/admin/leady?kos=1">Koš</a>
              <hr />
              <form method="post" action="/admin/logout" data-native><button type="submit">Odhlásit</button></form>
            </div>
          </details>
        </header>
        <main class="main" data-main><slot /></main>
      </div>
    )}
    <script>
      import '../scripts/admin';
    </script>
  </body>
</html>
