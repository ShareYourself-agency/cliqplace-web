---
import { nav } from '../data/site';
interface Props { theme?: 'dark' | 'light' }
const { theme = 'dark' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
---
<header class:list={['site-header', `site-header--${theme}`]} data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Cliqplace – úvodní stránka">
      <img class="logo-light" src="/svg/logo.svg" alt="Cliqplace – Where Connections Begin" width="131" height="34" />
      <img class="logo-dark" src="/svg/logo-dark.svg" alt="Cliqplace – Where Connections Begin" width="131" height="34" />
    </a>

    <nav class="site-nav" aria-label="Hlavní navigace">
      <ul role="list" class="site-nav__list" id="site-menu">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}><span class="roll" data-label={item.label}><span class="roll__t">{item.label}</span></span></a></li>
        ))}
        <li class="site-nav__mobile-cta"><a class="btn" href="/kontakt">Domluvit ukázku</a></li>
      </ul>
    </nav>

    <a class="btn site-header__cta" href="/kontakt">Domluvit ukázku</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <span class="sr-only">Otevřít menu</span>
      <span class="menu-toggle__bar" aria-hidden="true"></span>
      <span class="menu-toggle__bar" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    height: var(--header-h);
    transition: background-color 0.3s, backdrop-filter 0.3s, box-shadow 0.3s, transform 0.35s var(--ease-out);
  }
  .site-header--dark { color: #fff; }
  .site-header--light { color: var(--c-ink); }
  .site-header__logo .logo-dark { display: none; }
  .site-header--light:not(.menu-open) .site-header__logo .logo-light { display: none; }
  .site-header--light:not(.menu-open) .site-header__logo .logo-dark { display: block; }
  .site-header.is-scrolled.site-header--dark { background: rgba(12, 20, 18, 0.9); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 1px 0 rgba(255,255,255,0.06); }
  .site-header.is-scrolled.site-header--light { background: rgba(247, 248, 246, 0.82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 1px 0 rgba(13,21,19,0.06); }
  .site-header.is-hidden { transform: translateY(-100%); }

  .site-header__inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .site-header__logo img { width: clamp(7.25rem, 6.5rem + 1.5vw, 8.2rem); height: auto; }

  .site-nav__list { display: flex; gap: 2.25rem; font-size: 1rem; }
  .site-nav__list a:not(.btn) { position: relative; padding-block: 0.5rem; opacity: 0.92; transition: opacity 0.2s; }
  .site-nav__list a:not(.btn)::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0.15rem; height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: left; transition: transform 0.3s var(--ease-out);
  }
  .site-nav__list a:not(.btn):hover { opacity: 1; }
  .site-nav__list a:not(.btn):hover::after, .site-nav__list a[aria-current='page']::after { transform: scaleX(1); }
  .site-nav__mobile-cta { display: none; }

  /* hover: smooth colour change to lime with soft glow (no clipping) */
  .roll { display: inline-block; }
  .roll__t { transition: color 0.35s var(--ease-out), text-shadow 0.35s var(--ease-out); }
  .site-nav__list a:hover .roll__t, .site-nav__list a:focus-visible .roll__t { color: var(--c-lime); text-shadow: 0 0 14px rgba(199,255,156,0.55); }
  .site-header--light:not(.menu-open) .site-nav__list a:hover .roll__t { color: var(--c-green); text-shadow: none; }

  .menu-toggle { display: none; }

  @media (max-width: 1023.98px) {
    .site-header__cta { display: none; }
    .menu-toggle {
      display: grid; place-content: center; gap: 6px;
      width: 2.75rem; height: 2.75rem; border-radius: var(--radius-s);
      background: transparent; border: 1px solid currentColor; cursor: pointer; position: relative; z-index: 2;
    }
    .menu-toggle__bar { display: block; width: 1.125rem; height: 1.5px; background: currentColor; transition: transform 0.3s var(--ease-out); }
    .menu-toggle[aria-expanded='true'] .sr-only + .menu-toggle__bar { transform: translateY(3.75px) rotate(45deg); }
    .menu-toggle[aria-expanded='true'] .menu-toggle__bar + .menu-toggle__bar { transform: translateY(-3.75px) rotate(-45deg); }

    .site-nav {
      position: fixed; inset: 0; z-index: 1;
      background: var(--c-night); color: #fff;
      display: grid; align-content: center;
      padding: calc(var(--header-h) + 1rem) var(--gutter) 2rem;
      opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s;
    }
    .site-nav::before {
      content: ''; position: absolute; inset: 0; z-index: -1;
      background: radial-gradient(ellipse 80% 50% at 50% 60%, rgba(76,140,84,0.45), transparent 70%);
    }
    .site-header.menu-open .site-nav { opacity: 1; visibility: visible; }
    .site-header.menu-open { color: #fff; }
    
    .site-nav__list { flex-direction: column; gap: 0.25rem; font-size: clamp(1.75rem, 1.2rem + 3vw, 2.5rem); font-weight: 600; letter-spacing: -0.03em; }
    .site-nav__list a:not(.btn) { display: block; padding-block: 0.6rem; }
    .site-nav__list a:not(.btn)::after { display: none; }
    .site-nav__mobile-cta { display: block; margin-top: 1.5rem; }
    .site-nav__mobile-cta .btn { width: 100%; font-size: 1.0625rem; min-height: 3.25rem; }
    .site-header__logo { position: relative; z-index: 2; }
  }
</style>
