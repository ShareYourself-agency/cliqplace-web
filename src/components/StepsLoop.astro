---
import { Image } from 'astro:assets';
import network from '../assets/img/neon-green-glass-network.png';
interface Step { title: string; text: string }
interface Props { steps: Step[]; id?: string }
const { steps, id = 'jak-to-funguje' } = Astro.props;
const n = steps.length;
---
<section class="steps-wrap section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="steps" data-steps-scroll style={`--n:${n}`}>
      <Image class="steps__pipes" src={network} alt="" widths={[900, 1400, 1906]} quality={92} sizes="(min-width: 1024px) 1280px, 100vw" loading="lazy" />

      <h2 class="h2 center steps__title" id={`${id}-title`}>Jak to funguje?</h2>

      <ol role="list" class="steps__list">
        {steps.map((s, i) => (
          <li class="step" data-step data-state={i === 0 ? 'active' : 'next'}>
            <div class="step__marker">
              <span class="step__num">{i + 1}</span>
              {i < n - 1 && <span class="step__line" aria-hidden="true"><span></span></span>}
            </div>
            <div class="step__body">
              <h3 class="step__title" set:html={s.title} />
              <p class="step__text">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .steps-wrap { padding-block: 0; }

  .steps {
    position: relative; isolation: isolate; overflow: hidden;
    border-radius: var(--radius-xl); color: #fff;
    padding: clamp(3rem, 2.5rem + 3.5vw, 5.5rem) clamp(1.25rem, 0.5rem + 3.5vw, 4rem) clamp(3rem, 2rem + 3vw, 5rem);
    background: linear-gradient(180deg, #386041 0%, #22392b 55%, #111c17 100%);
  }
  .steps__pipes { position: absolute; left: 50%; top: 58%; width: 125%; max-width: none; height: auto; transform: translate(-50%, -50%); z-index: -1; opacity: 0.16; filter: saturate(0.35) brightness(1.1); pointer-events: none; mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 55%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 55%, transparent 100%); }
  .steps__title { margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.75rem); }

  /* mobile: vertical timeline */
  .steps__list { display: grid; gap: 0; }
  .step { display: grid; grid-template-columns: auto 1fr; column-gap: 1rem; }
  .step__marker { display: flex; flex-direction: column; align-items: center; }
  .step__num {
    flex: none; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 0.75rem;
    font-size: 1.25rem; font-weight: 500; color: rgba(199,255,156,0.35);
    border: 1px solid rgba(199,255,156,0.22);
    background: rgba(255,255,255,0.03);
    transition: color 0.4s, border-color 0.4s, background-color 0.4s, box-shadow 0.4s;
  }
  .step__line { flex: 1; width: 2px; min-height: 1.5rem; margin-block: 0.5rem; background: rgba(199,255,156,0.14); border-radius: 2px; overflow: hidden; }
  .step__line span { display: block; width: 100%; height: 100%; background: var(--c-lime-2); transform: scaleY(0); transform-origin: top; transition: transform 0.6s var(--ease-out); }
  .step__body { padding: 0.55rem 0 1.75rem; }
  .step:last-child .step__body { padding-bottom: 0; }
  .step__title { font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5625rem); letter-spacing: -0.03em; margin-bottom: 0.5rem; transition: opacity 0.4s; }
  .step__text { color: rgba(255,255,255,0.82); max-width: 22rem; transition: opacity 0.4s; }

  .step[data-state='done'] .step__num, .step[data-state='active'] .step__num {
    color: var(--c-lime); border-color: rgba(199,255,156,0.85); background: rgba(177,235,130,0.12);
  }
  .step[data-state='active'] .step__num { box-shadow: 0 0 0 4px rgba(199,255,156,0.12), 0 0 24px rgba(177,235,130,0.35); }
  .step[data-state='done'] .step__line span { transform: none; }
  .step[data-state='next'] .step__title, .step[data-state='next'] .step__text { opacity: 0.55; }

  /* tablet & desktop: horizontal */
  @media (min-width: 768px) {
    .steps__list { grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); gap: 1.5rem; }
    .step { display: block; }
    .step__marker { flex-direction: row; gap: 0.75rem; margin-bottom: 1.75rem; }
    .step__num { width: 3rem; height: 3rem; font-size: 1.5rem; }
    .step__line { width: auto; height: 2px; min-height: 0; margin: 0; }
    .step__line span { transform: scaleX(0); transform-origin: left; }
    .step__body { padding: 0; }
    .step__text { max-width: 18rem; }
  }
</style>
