---
import { reviews as all } from '../data/reviews';
const len = (r: (typeof all)[number]) => r.text.join(' ').length;
const reviews = [...all].sort((a, b) => len(a) - len(b));
interface Props { title?: string }
const { title = 'Příběhy našich klientů' } = Astro.props;
const n = reviews.length;
---
<section class="reviews section" aria-labelledby="reviews-title">
  <div class="container">
    <h2 class="h2 center reviews__title" id="reviews-title">{title}</h2>

    <div class="reviews__carousel" data-loop="reviews" data-count={n} data-interval="7000" aria-roledescription="carousel" aria-label="Reference klientů">
      <div class="reviews__stage" data-loop-stage>
        {reviews.map((r, i) => (
          <article class="review" data-loop-item={i} aria-roledescription="slide" aria-label={`${i + 1} z ${n}: ${r.name}`}>
            <header class="review__head">
              <h3 class="review__name">{r.name}</h3>
              <span class="review__tag">{r.type}</span>
            </header>
            <div class="review__text" data-review-text>
              {r.text.map((p) => <p>{p}</p>)}
              {r.person && <p class="review__person">— {r.person}</p>}
            </div>
            <button type="button" class="review__more" data-review-more hidden>Číst celou recenzi</button>
          </article>
        ))}
      </div>

      <div class="slidebar">
        <label class="sr-only" for="reviews-range">Vyberte referenci</label>
        <input id="reviews-range" class="slidebar__range" type="range" min="0" max={n - 1} step="1" value="0" data-loop-range aria-valuetext={`${reviews[0].name}`} />
      </div>
      <p class="sr-only" aria-live="polite" data-loop-live></p>
    </div>
  </div>
</section>

<style>
  .reviews { overflow: hidden; }
  .reviews__title { margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem); }
  .reviews__stage {
    display: grid; position: relative; touch-action: pan-y;
    max-width: 30rem; margin-inline: auto;
  }
  /* all cards share one fixed height → nothing jumps when reviews change */
  .reviews__carousel { --rh-max: 19; --rh: 19rem; }
  :global(.js) .reviews__stage { height: var(--rh); transition: height 0.5s var(--ease-out); }
  :global(.js) .reviews__stage.is-expanded { height: var(--open-h, var(--rh)); }
  :global(.js) .review { align-self: start; height: var(--rh); display: flex; flex-direction: column; }
  :global(.js) .review.is-open { height: auto; }
  :global(.js) .review__text { flex: 1; min-height: 0; overflow: hidden; }
  /* safe centring: auto margins collapse to 0 when content is taller, so text can never spill out of the card */
  :global(.js) .review { overflow: hidden; }
  :global(.js) .review:not(.is-clamped) .review__head { margin-top: auto; }
  :global(.js) .review:not(.is-clamped) .review__text { flex: 0 1 auto; margin-bottom: auto; }
  :global(.js) .review.is-clamped:not(.is-open) .review__text {
    mask-image: linear-gradient(180deg, #000 72%, transparent);
    -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent);
  }
  .review__more {
    align-self: flex-start; margin-top: 0.75rem; padding: 0.35rem 0; border: 0; background: none; cursor: pointer;
    font-size: 0.875rem; font-weight: 600; color: var(--c-green); text-decoration: underline; text-underline-offset: 3px;
  }
  .review__more[hidden] { display: none; }
  .review:not([data-pos="0"]) .review__more { visibility: hidden; }
  @media (max-width: 639.98px) { .reviews__carousel { --rh-max: 16; --rh: 16rem; } }
  .review {
    grid-area: 1 / 1; align-self: center;
    background: var(--c-sage); border: 1px solid var(--c-line); border-radius: var(--radius);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.5s ease;
    will-change: transform, opacity; backface-visibility: hidden;
    transform: translateX(0) scale(0.84); opacity: 0; pointer-events: none;
    box-shadow: 0 20px 50px -30px rgba(13, 21, 19, 0.35);
    user-select: none;
  }
  .review[data-pos='0'] { opacity: 1; transform: none; z-index: 3; pointer-events: auto; user-select: text; }
  .review[data-pos='-1'], .review[data-pos='1'] { opacity: 0.8; z-index: 2; pointer-events: auto; cursor: pointer; }
  .review[data-pos='-1'] { transform: translateX(-46%) translateY(3%) scale(0.88); }
  .review[data-pos='1'] { transform: translateX(46%) translateY(3%) scale(0.88); }
  .review[data-pos='-1'] .review__text, .review[data-pos='1'] .review__text { opacity: 0.55; }
  .review__head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin-bottom: 1rem; }
  .review__name { font-size: 1.375rem; letter-spacing: -0.03em; }
  .review__tag {
    font-size: 0.8125rem; color: var(--c-text); padding: 0.25rem 0.625rem; border-radius: 99px;
    border: 1px solid rgba(54, 93, 63, 0.45); background: rgba(255,255,255,0.35);
  }
  .review__text { display: flex; flex-direction: column; gap: 0.55rem; color: var(--c-text); line-height: 1.5; font-size: 0.975rem; }
  .review__person { margin-top: 1rem; font-size: 0.875rem; color: var(--c-green); font-weight: 500; }

  .slidebar { max-width: 30rem; margin: 1.75rem auto 0; }

  @media (max-width: 639.98px) {
    /* phones: simple crossfade with a small slide – no scaling */
    .review { transform: none; }
    .review[data-pos='-1'] { transform: translateX(-12%); opacity: 0; pointer-events: none; }
    .review[data-pos='1'] { transform: translateX(12%); opacity: 0; pointer-events: none; }
    .review[data-pos='2'] { transform: translateX(12%); }
    .review[data-pos='-2'] { transform: translateX(-12%); }
  }
</style>
