---
/* Live dashboard mockup for the Software hero – numbers tick up, chart keeps working. */
const bars = [42, 68, 55, 74, 60, 48, 63, 82, 70, 88, 96];
const nav = ['Akce', 'Prodej', 'Sály', 'Vouchery a slevy', 'Zboží', 'Zákazníci'];
---
<div class="sd" data-live-dash aria-hidden="true">
  <aside class="sd-side">
    <p class="sd-brand"><span class="sd-ico"><i></i><i></i><i></i><i></i></span>Přehled</p>
    <ul>
      {nav.map((n, i) => <li class:list={{ 'is-on': i === 0 }}>{n}</li>)}
    </ul>
  </aside>
  <div class="sd-main">
    <div class="sd-kpis">
      <div class="sd-kpi sd-kpi--light">
        <p class="sd-l">Prodané vstupenky</p>
        <p class="sd-n" data-sold>6 628</p>
        <p class="sd-up"><span>▲</span> <b data-trend>12</b> % tento týden</p>
      </div>
      <div class="sd-kpi">
        <p class="sd-l">Odbaveno</p>
        <p class="sd-n"><span data-scanned>3 256</span><small>/<span data-cap>6 628</span></small></p>
        <div class="sd-bar"><span data-scan-bar></span></div>
      </div>
      <div class="sd-kpi">
        <p class="sd-l">Dnešní akce</p>
        <p class="sd-event">Festival Mikulov</p>
        <p class="sd-live"><span></span>Probíhá odbavení</p>
      </div>
    </div>
    <div class="sd-chart">
      <div class="sd-chart__head"><p class="sd-l sd-l--dark">Prodej za posledních 14 dní</p><p class="sd-plus" data-plus>+1 vstupenka</p></div>
      <div class="sd-bars" data-bars>
        {bars.map((h, i) => <span class:list={['sd-b', `sd-b--${i % 3}`]} style={`--h:${h}%`}></span>)}
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-live-dash]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    const fmt = new Intl.NumberFormat('cs-CZ');
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const soldEl = $('[data-sold]'), scannedEl = $('[data-scanned]'), capEl = $('[data-cap]');
    const barEl = $('[data-scan-bar]'), barsEl = $('[data-bars]'), plusEl = $('[data-plus]'), trendEl = $('[data-trend]');
    let sold = 6628, scanned = 3256, shown = { sold, scanned };
    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(root);

    // smooth number tween
    const tween = (from: number, to: number, el: HTMLElement, key: 'sold' | 'scanned') => {
      const t0 = performance.now(); const d = 900;
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / d); const v = Math.round(from + (to - from) * (1 - Math.pow(1 - p, 3)));
        el.textContent = fmt.format(v); shown[key] = v;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const setBar = () => { barEl.style.transform = `scaleX(${Math.min(1, scanned / sold)})`; };
    setBar();

    // intro: count up from lower values
    tween(5200, sold, soldEl, 'sold');
    tween(1800, scanned, scannedEl, 'scanned');

    const tick = () => {
      if (!visible || document.hidden) return;
      const add = 1 + Math.floor(Math.random() * 4);
      const from = shown.sold; sold += add;
      tween(from, sold, soldEl, 'sold');
      capEl.textContent = fmt.format(sold);
      const scanAdd = 2 + Math.floor(Math.random() * 6);
      const sFrom = shown.scanned; scanned = Math.min(sold, scanned + scanAdd);
      tween(sFrom, scanned, scannedEl, 'scanned');
      setBar();
      plusEl.textContent = `+${add} ${add === 1 ? 'vstupenka' : add < 5 ? 'vstupenky' : 'vstupenek'}`;
      plusEl.classList.remove('is-pop'); void plusEl.offsetWidth; plusEl.classList.add('is-pop');
      // today's bar grows
      const last = barsEl.lastElementChild as HTMLElement;
      const h = parseFloat(last.style.getPropertyValue('--h'));
      last.style.setProperty('--h', `${Math.min(100, h + add * 0.8)}%`);
      if (Math.random() < 0.08) trendEl.textContent = String(11 + Math.floor(Math.random() * 4));
    };
    setInterval(tick, 1600);

    // every few seconds a new day starts: chart shifts left
    setInterval(() => {
      if (!visible || document.hidden) return;
      const first = barsEl.firstElementChild as HTMLElement;
      first.classList.add('is-out');
      setTimeout(() => {
        first.remove();
        const nb = document.createElement('span');
        nb.className = `sd-b sd-b--${Math.floor(Math.random() * 3)} is-new`;
        nb.style.setProperty('--h', '18%');
        barsEl.appendChild(nb);
        requestAnimationFrame(() => requestAnimationFrame(() => { nb.classList.remove('is-new'); nb.style.setProperty('--h', `${40 + Math.random() * 30}%`); }));
      }, 500);
    }, 7000);
  }
</script>

<style>
  .sd {
    --pad: 2.4cqw;
    container-type: inline-size;
    display: grid; grid-template-columns: 19% 1fr; gap: var(--pad);
    width: min(100%, 68rem); margin-inline: auto; aspect-ratio: 1087 / 400;
    padding: var(--pad); border-radius: 2.4cqw 2.4cqw 0 0;
    background: linear-gradient(180deg, #1c2b22, #15211a);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 -20px 60px rgba(93,255,74,0.08);
    font-family: var(--font); color: #fff; overflow: hidden;
  }
  .sd-side { font-size: 1.25cqw; font-weight: 600; }
  .sd-brand { display: flex; align-items: center; gap: 1cqw; font-size: 1.3cqw; margin: 0.6cqw 0 2.4cqw; }
  .sd-ico { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25cqw; padding: 0.55cqw; width: 2.4cqw; height: 2.4cqw; border-radius: 0.5cqw; background: rgba(255,255,255,0.08); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.15); }
  .sd-ico i { background: var(--c-lime); border-radius: 1px; }
  .sd-side ul { list-style: none; padding: 0; display: grid; gap: 0.4cqw; }
  .sd-side li { padding: 0.75cqw 0.8cqw; border-radius: 0.6cqw; color: rgba(255,255,255,0.88); }
  .sd-side li.is-on { background: rgba(255,255,255,0.08); color: var(--c-lime); }

  .sd-main { display: grid; grid-template-rows: auto 1fr; gap: 1.2cqw; min-height: 0; }
  .sd-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2cqw; }
  .sd-kpi { padding: 1.2cqw 1.4cqw; border-radius: 1.2cqw; background: #2b3d31; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06); }
  .sd-kpi--light { background: #bcd5b1; color: #0d1513; }
  .sd-l { font-size: 1.05cqw; font-weight: 600; opacity: 0.9; }
  .sd-n { font-size: 3.6cqw; font-weight: 700; letter-spacing: -0.04em; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .sd-n small { font-size: 2.2cqw; opacity: 0.55; font-weight: 600; }
  .sd-up { font-size: 1cqw; font-weight: 700; color: #2e7d32; }
  .sd-up span { display: inline-block; animation: sd-bob 1.6s ease-in-out infinite; }
  .sd-bar { height: 0.6cqw; margin-top: 0.8cqw; border-radius: 99px; background: rgba(255,255,255,0.12); overflow: hidden; }
  .sd-bar span { display: block; height: 100%; background: linear-gradient(90deg, #5dff4a, var(--c-lime)); transform-origin: left; transition: transform 0.9s var(--ease-out); box-shadow: 0 0 10px rgba(93,255,74,0.6); }
  .sd-event { font-size: 2.3cqw; font-weight: 700; letter-spacing: -0.03em; margin-top: 0.6cqw; }
  .sd-live { display: flex; align-items: center; gap: 0.6cqw; margin-top: 0.6cqw; font-size: 1cqw; color: var(--c-lime); }
  .sd-live span { width: 0.8cqw; height: 0.8cqw; border-radius: 50%; background: #5dff4a; animation: sd-ping 1.5s infinite; }

  .sd-chart { display: grid; grid-template-rows: auto 1fr; padding: 1.2cqw 1.4cqw 0; border-radius: 1.2cqw 1.2cqw 0 0; background: #bcd5b1; color: #0d1513; min-height: 0; }
  .sd-chart__head { display: flex; justify-content: space-between; align-items: center; }
  .sd-l--dark { opacity: 0.85; }
  .sd-plus { font-size: 1cqw; font-weight: 700; color: #1f6b2a; opacity: 0; }
  .sd-plus.is-pop { animation: sd-pop 1.4s var(--ease-out); }
  .sd-bars { display: flex; align-items: flex-end; gap: 0.9cqw; padding-top: 1.2cqw; min-height: 0; }
  .sd-b {
    flex: 1; height: var(--h); border-radius: 0.6cqw 0.6cqw 0 0;
    transition: height 0.9s var(--ease-out), flex-grow 0.5s var(--ease-out), opacity 0.5s, margin 0.5s;
  }
  .sd-b--0 { background: #5a9a65; }
  .sd-b--1 { background: #2c4b35; }
  .sd-b--2 { background: #3f7049; }
  .sd-b:last-child { background: linear-gradient(180deg, #5dff4a, #3f9f3a); box-shadow: 0 0 1.6cqw rgba(93,255,74,0.45); }
  .sd-b.is-out { flex-grow: 0.0001; opacity: 0; margin-right: -0.9cqw; }
  .sd-b.is-new { flex-grow: 0.0001; }

  @keyframes sd-bob { 50% { translate: 0 -0.25cqw; } }
  @keyframes sd-ping { 0% { box-shadow: 0 0 0 0 rgba(93,255,74,0.6); } 80%, 100% { box-shadow: 0 0 0 0.9cqw rgba(93,255,74,0); } }
  @keyframes sd-pop { 0% { opacity: 0; translate: 0 0.6cqw; } 20%, 70% { opacity: 1; translate: 0 0; } 100% { opacity: 0; translate: 0 -0.6cqw; } }
</style>
