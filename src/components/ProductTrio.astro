---
import { Image } from 'astro:assets';
import swImg from '../assets/img/software-karta.png';
import hwImg from '../assets/img/hardware-larta.png';
import ptImg from '../assets/img/portal-karta.png';

interface Props { current: 'software' | 'hardware' | 'portal'; title: string }
const { current, title } = Astro.props;
const items = [
  { key: 'software', n: '01 / Software', t: 'Všechno pod kontrolou.<br /> Bez zbytečné složitosti.', d: 'Správa akcí, sálů, prodeje, rezervací, vstupenek, zákazníků, voucherů, zboží…', img: swImg, href: '/software', cta: 'Prozkoumat software', alt: 'Ukázka administrace systému Entradio na tabletu' },
  { key: 'hardware', n: '02 / Hardware', t: 'Od pokladny až ke vstupu.', d: 'Skenery, tiskárny, platební terminály, kiosky a další zařízení připravená fungovat s celým systémem.', img: hwImg, href: '/hardware', cta: 'Prozkoumat hardware', alt: 'Čtečka vstupenek, platební terminál a tiskárna vstupenek' },
  { key: 'portal', n: '03 / Portál', t: 'Místo, kde se návštěvník dostane ke své vstupence.', d: 'Online prodej prostřednictvím mytickets.vip nebo white-label řešení pod vlastní značkou pořadatele.', img: ptImg, href: '/portal', cta: 'Prozkoumat portál', alt: 'Prodejní portál MyTickets v mobilu' },
] as const;
---
<section class="trio section" aria-labelledby="trio-title">
  <div class="container">
    <h2 class="h2 center trio__title" id="trio-title">{title}</h2>
    <ul role="list" class="trio__grid">
      {items.map((it, i) => {
        const active = it.key === current;
        return (
          <li class:list={['trio__card', { 'is-current': active }]} data-reveal style={`--d:${i * 0.08}s`}>
            <p class="trio__n">{it.n}</p>
            <h3 class="trio__t" set:html={it.t} />
            <p class="trio__d">{it.d}</p>
            <div class="trio__img"><Image src={it.img} alt={it.alt} widths={[400, 800, 1200]} quality={92} sizes="(min-width: 1024px) 400px, 90vw" loading="lazy" /></div>
            {active
              ? <a class="btn btn--ghost-dark btn--block trio__btn" href="#main">Zpět nahoru</a>
              : <a class="btn btn--soft btn--block trio__btn" href={it.href}>{it.cta}</a>}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .trio__title { margin-bottom: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem); }
  .trio__grid { display: grid; gap: 1.25rem; }
  .trio__card {
    position: relative; display: flex; flex-direction: column;
    background: var(--c-sage); border-radius: var(--radius-l); border: 1px solid transparent;
    padding: 1.5rem 1.5rem 1.5rem; overflow: hidden;
    transition: translate 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }
  .trio__card:hover { box-shadow: 0 24px 40px -28px rgba(13,21,19,0.45); }
  .trio__card.is-current { background: var(--c-sage-strong); border-color: var(--c-lime-2); }
  .trio__n { font-size: 0.9375rem; margin-bottom: 0.75rem; }
  .trio__t { font-size: clamp(1.375rem, 1.25rem + 0.4vw, 1.5rem); letter-spacing: -0.03em; margin-bottom: 0.875rem; max-width: 18ch; }
  .trio__d { color: var(--c-text); font-size: 0.9375rem; max-width: 30ch; }
  .trio__img {
    margin-top: auto; padding-top: 1.75rem; display: flex; justify-content: center; align-items: flex-end;
    height: 13.5rem;
  }
  .trio__img img { width: 100%; height: 100%; max-height: none; object-fit: contain; object-position: center bottom; }
  .trio__img { position: relative; }
  .trio__img::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 35%; background: linear-gradient(180deg, transparent, var(--card-bg)); pointer-events: none; }
  .trio__card { --card-bg: var(--c-sage); }
  .trio__card.is-current { --card-bg: var(--c-sage-strong); }
  .trio__btn { position: relative; margin-top: -0.75rem; }
  .is-current .trio__btn { background: rgba(255,255,255,0.35); }
  @media (min-width: 640px) and (max-width: 1023.98px) {
    .trio__card { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); column-gap: 1.5rem; align-items: center; }
    .trio__n, .trio__t, .trio__d, .trio__btn { grid-column: 1; }
    .trio__img { grid-column: 2; grid-row: 1 / span 4; height: 13rem; padding-top: 0; }
    .trio__btn { margin-top: 1.25rem; justify-self: start; width: auto; }
  }
  @media (min-width: 1024px) {
    .trio__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .trio__img { height: 14.5rem; }
  }
</style>
